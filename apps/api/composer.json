{
  "name": "lavbe/api",
  "description": "Same-origin PHP API for Lavbe Wheel",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-sodium": "*",
    "opis/json-schema": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "Lavbe\\Api\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "bootstrap-admin": "php bin/bootstrap-admin.php",
    "migrate": "php bin/migrate.php",
    "cleanup": "php bin/cleanup.php"
  },
  "config": {
    "sort-packages": true,
    "platform-check": true
  }
}
