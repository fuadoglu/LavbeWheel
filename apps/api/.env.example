# Copy to a protected environment file outside the web root; never commit real values.
LAVBE_APP_ORIGIN=https://lavbe.com
LAVBE_PUBLIC_ORIGIN=https://lavbe.com
LAVBE_DATABASE_DSN=mysql:host=127.0.0.1;dbname=lavbe;charset=utf8mb4
LAVBE_DATABASE_USER=lavbe
LAVBE_DATABASE_PASSWORD=replace-outside-source-control
LAVBE_ENCRYPTION_KEY_ID=key-2026-01
# Generate 32 random bytes and base64-encode them; configure the decoded bytes
# through your secret manager (not a literal placeholder in this file).
LAVBE_ENCRYPTION_KEY=
LAVBE_RATE_KEY=
# Base64-encoded 64-byte Ed25519 signing secret key; keep it outside source control.
LAVBE_MANIFEST_SIGNING_SECRET_KEY=
# Comma-separated exact proxy IPs only. Never trust arbitrary forwarding headers.
LAVBE_TRUSTED_PROXIES=
