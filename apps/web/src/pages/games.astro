---
import '../styles/global.css';
import messages from '../../../../content/locales/az.json';
import { designTokens, getLocaleDirection } from '../data/config';
import playIcon from '../../../../assets/icons/phosphor/regular/dice-five.svg';
import moonIcon from '../../../../assets/icons/phosphor/regular/moon.svg';
import sunIcon from '../../../../assets/icons/phosphor/regular/sun.svg';
import { getPublishedAlternates, getSeoPageState, getXDefaultHref } from '../data/seo';
const m = messages.messages;
const light = designTokens.themes.light;
const seo = getSeoPageState('group-games', messages.locale, '/games/');
const alternates = getPublishedAlternates('group-games');
const xDefaultHref = getXDefaultHref('group-games');
---
<!doctype html>
<html lang={messages.locale} dir={getLocaleDirection(messages.locale)} data-theme-tokens={JSON.stringify(designTokens.themes)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={light.canvas} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themes = JSON.parse(root.dataset.themeTokens || '{}');
        const variables = { canvas: '--canvas-token', surface: '--surface-token', text: '--text-token', mutedText: '--muted-token', primary: '--primary-token', onPrimary: '--on-primary', border: '--border-token', focus: '--focus-token' };
        let theme = 'light';
        try { theme = localStorage.getItem('lavbe.theme') === 'dark' ? 'dark' : 'light'; } catch { /* Keep accessible light defaults if storage is unavailable. */ }
        root.dataset.theme = theme;
        for (const [key, variable] of Object.entries(variables)) root.style.setProperty(variable, themes[theme][key]);
      })();
    </script>
    <meta name="description" content={seo.approvedCopy?.description ?? m.gameDescription} />
    <meta name="robots" content={seo.robots} />
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
    {seo.robots === 'index,follow' && xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    <title>{seo.approvedCopy?.title ?? `${m.gameTitle} · Lavbe`}</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">L</span><span>lavbe</span></a>
        <nav aria-label={m.navMain}><a href="/">{m.navWheel}</a><a href="/bottle/">{m.navBottle}</a><a class="nav-active" href="/games/" aria-current="page">{m.gameNav}</a></nav>
        <div class="header-actions"><span class="locale" aria-label={m.language}>{m.languageCode}</span><button class="theme-toggle" id="theme-toggle" type="button" data-light-label={m.themeToLight} data-dark-label={m.themeToDark} data-light-icon={sunIcon.src} data-dark-icon={moonIcon.src} aria-label={m.themeToDark}><img width="19" height="19" src={moonIcon.src} alt="" aria-hidden="true" /></button></div>
      </header>
      <section class="tool-strip" aria-label={m.gameNav}><img class="tool-icon" src={playIcon.src} width="20" height="20" alt="" aria-hidden="true" /><span class="tool-name">{m.gameNav}</span><span class="tool-caption">{m.gameDescription}</span><span class="tool-presence">{m.localOnly}</span></section>
      <section class="game-layout">
        <section class="game-panel" aria-labelledby="game-title">
          <div class="game-heading"><div><span class="section-kicker">LAVBE / {m.gameNav.toUpperCase()}</span><h1 id="game-title">{seo.approvedCopy?.h1 ?? m.gameTitle}</h1></div><span class="game-round" aria-hidden="true">✦</span></div>
          <p class="game-description">{m.gameDescription}</p>
          <p class="game-status" id="game-pack-language">{m.gamePackLanguageNotice}</p>
          <form id="game-setup" class="game-setup">
            <label for="game-pack">{m.gamePackLabel}<select class="motion-select" id="game-pack"><option value="icebreakers">{m.gameFamilyIcebreakers}</option><option value="friends">{m.gameFamilyFriends}</option><option value="couples">{m.gameFamilyCouples}</option><option value="truth">{m.gameFamilyTruth}</option><option value="dare">{m.gameFamilyDare}</option><option value="family">{m.gameFamilyFamily}</option></select></label>
            <label for="game-players">{m.gamePlayersLabel}<textarea id="game-players" rows="5" autocomplete="off" required>Aylin&#10;Murad&#10;Leyla</textarea></label>
            <p class="game-safety">{m.gameDraftPackWarning}<br />{m.gamePassNotice}</p>
            <button class="spin-button" id="game-start" type="submit" disabled><img class="spin-icon" src={playIcon.src} width="18" height="18" alt="" aria-hidden="true" />{m.gameStart}</button>
          </form>
          <div id="game-play" class="game-play" hidden>
            <label for="saved-games">{m.gameSavedGames}<select class="motion-select" id="saved-games"></select></label>
            <p id="game-status" class="game-status" role="status"></p>
            <article id="game-card" class="game-card" aria-live="polite" hidden><span id="game-player" class="game-player"></span><p id="game-card-text" class="game-card-text"></p><small id="game-card-count" class="game-card-count"></small></article>
            <div class="game-actions">
              <button id="game-draw" class="spin-button" type="button">{m.gameDraw}</button>
              <button id="game-done" type="button">{m.gameDone}</button><button id="game-skip" type="button">{m.gameSkip}</button>
              <button id="game-pause" type="button">{m.gamePause}</button><button id="game-resume" type="button">{m.gameResume}</button>
              <button id="game-restart" type="button">{m.gameRestart}</button><button id="game-end" type="button">{m.gameEnd}</button><button id="game-new" type="button">{m.gameStart}</button>
            </div>
            <h2 class="game-history-heading">{m.gameHistoryHeading}</h2><ol id="game-history" class="game-history"></ol>
          </div>
          <p id="game-error" class="game-error" role="alert" hidden></p>
        </section>
      </section>
      <footer><span>Lavbe <span class="footer-sep">·</span>{m.footerTagline}</span><span>{m.footerPromise}</span></footer>
    </main>
    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const save = (key, value) => { try { localStorage.setItem(key, value); } catch { /* Preference stays temporary when local storage is unavailable. */ } };
        const setTheme = (theme) => {
          const themes = JSON.parse(root.dataset.themeTokens || '{}');
          const variables = { canvas: '--canvas-token', surface: '--surface-token', text: '--text-token', mutedText: '--muted-token', primary: '--primary-token', onPrimary: '--on-primary', border: '--border-token', focus: '--focus-token' };
          root.dataset.theme = theme;
          for (const [key, variable] of Object.entries(variables)) root.style.setProperty(variable, themes[theme][key]);
          button?.setAttribute('aria-label', theme === 'dark' ? button.dataset.lightLabel : button.dataset.darkLabel);
          const icon = button?.querySelector('img');
          if (icon && button) icon.src = theme === 'dark' ? button.dataset.lightIcon : button.dataset.darkIcon;
        };
        setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
        button?.addEventListener('click', () => { const next = root.dataset.theme === 'dark' ? 'light' : 'dark'; save('lavbe.theme', next); setTheme(next); });
      })();
    </script>
    <script src="../scripts/games.ts"></script>
  </body>
</html>
