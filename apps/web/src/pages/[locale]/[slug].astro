---
import '../../styles/global.css';
import enCatalog from '../../../../../content/locales/en.json';
import azCatalog from '../../../../../content/locales/az.json';
import routeRegistry from '../../../../../config/seo/routes.json';
import { designTokens, getLocaleDirection } from '../../data/config';
import bottleIcon from '../../../../../assets/icons/phosphor/regular/beer-bottle.svg';
import playIcon from '../../../../../assets/icons/phosphor/regular/dice-five.svg';
import moonIcon from '../../../../../assets/icons/phosphor/regular/moon.svg';
import sunIcon from '../../../../../assets/icons/phosphor/regular/sun.svg';
import { getPublishedAlternates, getSeoPageState, getXDefaultHref } from '../../data/seo';

export function getStaticPaths() {
  const catalogs = { en: enCatalog, az: azCatalog };
  const routes = routeRegistry.routes.filter((route) => ['spin-the-bottle', 'group-games'].includes(route.id));
  return Object.entries(catalogs).flatMap(([locale, catalog]) => routes.map((route) => ({
    params: { locale, slug: route.slug },
    props: { locale, routeId: route.id, path: `/${locale}/${route.slug}/`, messages: catalog },
  })));
}

const { locale, routeId, path, messages } = Astro.props;
const m = messages.messages;
const isBottle = routeId === 'spin-the-bottle';
const title = isBottle ? m.bottleTitle : m.gameTitle;
const description = isBottle ? m.bottleDescription : m.gameDescription;
const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const otherLocale = locale === 'en' ? 'az' : 'en';
const routeSlug = path.split('/').filter(Boolean).at(-1)!;
const localeSwitchHref = `/${otherLocale}/${routeSlug}/`;
const bottleHref = `/${locale}/spin-the-bottle/`;
const gamesHref = `/${locale}/group-games/`;
const seo = getSeoPageState(routeId, locale, path);
const alternates = getPublishedAlternates(routeId);
const xDefaultHref = getXDefaultHref(routeId);
const light = designTokens.themes.light;
---
<!doctype html>
<html lang={locale} dir={getLocaleDirection(locale)} data-theme-tokens={JSON.stringify(designTokens.themes)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/lavbe-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content={light.canvas} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themes = JSON.parse(root.dataset.themeTokens || '{}');
        const variables = { canvas: '--canvas-token', surface: '--surface-token', text: '--text-token', mutedText: '--muted-token', primary: '--primary-token', onPrimary: '--on-primary', border: '--border-token', focus: '--focus-token' };
        let theme = 'light';
        try { theme = localStorage.getItem('lavbe.theme') === 'dark' ? 'dark' : 'light'; } catch { /* Keep accessible light defaults. */ }
        root.dataset.theme = theme;
        for (const [key, variable] of Object.entries(variables)) root.style.setProperty(variable, themes[theme][key]);
      })();
    </script>
    <meta name="description" content={seo.approvedCopy?.description ?? description} />
    <meta name="robots" content={seo.robots} />
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
    {seo.robots === 'index,follow' && xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    <title>{seo.approvedCopy?.title ?? `${title} · Lavbe`}</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href={homeHref}><span class="brand-mark" aria-hidden="true">L</span><span>lavbe</span></a>
        <nav aria-label={m.navMain}>
          <a href={homeHref}>{m.navWheel}</a>
          <a class={isBottle ? 'nav-active' : undefined} href={bottleHref} aria-current={isBottle ? 'page' : undefined}>{m.navBottle}</a>
          <a class={!isBottle ? 'nav-active' : undefined} href={gamesHref} aria-current={!isBottle ? 'page' : undefined}>{m.gameNav}</a>
        </nav>
        <div class="header-actions"><a class="locale" href={localeSwitchHref}>{locale === 'en' ? 'AZ' : 'EN'}</a><button class="theme-toggle" id="theme-toggle" type="button" data-light-label={m.themeToLight} data-dark-label={m.themeToDark} data-light-icon={sunIcon.src} data-dark-icon={moonIcon.src} aria-label={m.themeToDark}><img width="19" height="19" src={moonIcon.src} alt="" aria-hidden="true" /></button></div>
      </header>
      {isBottle ? <>
        <section class="tool-strip" aria-label={m.navBottle}><img class="tool-icon" src={bottleIcon.src} width="20" height="20" alt="" aria-hidden="true" /><span class="tool-name">{m.navBottle}</span><span class="tool-caption">{m.bottleDescription}</span><span class="tool-presence">{m.localOnly}</span></section>
        <section class="bottle-layout"><section class="bottle-panel" aria-labelledby="bottle-title">
          <div class="game-heading"><div><span class="section-kicker">LAVBE / {m.navBottle.toUpperCase()}</span><h1 id="bottle-title">{seo.approvedCopy?.h1 ?? m.bottleTitle}</h1></div><span class="game-round" aria-hidden="true">◉</span></div>
          <p class="game-description">{m.bottleDescription}</p>
          <form id="bottle-setup" class="game-setup"><label for="bottle-names">{m.bottleParticipants}<textarea id="bottle-names" rows="5" required>Aylin&#10;Murad&#10;Leyla&#10;Kamran</textarea></label><label for="bottle-mode">{m.bottleMode}<select id="bottle-mode" class="motion-select"><option value="independent">{m.bottleModeIndependent}</option><option value="remove-winner">{m.bottleModeRemove}</option><option value="shuffled-cycle">{m.bottleModeCycle}</option></select></label><button id="bottle-start" class="spin-button" type="submit" disabled><img class="spin-icon" src={bottleIcon.src} width="18" height="18" alt="" aria-hidden="true" />{m.bottleStart}</button></form>
          <div id="bottle-play" class="bottle-play" hidden><label for="bottle-sessions">{m.bottleSavedSessions}<select id="bottle-sessions" class="motion-select"></select></label><div class="bottle-wheel-wrap"><div class="bottle-pointer" aria-hidden="true"></div><canvas id="bottle-wheel" width="640" height="640" aria-label={m.bottleTitle}></canvas><img class="bottle-spinner" src={bottleIcon.src} width="76" height="76" alt="" aria-hidden="true" /></div><button id="bottle-spin" class="spin-button" type="button">{m.bottleSpin}</button><p id="bottle-result" class="wheel-note" aria-live="polite"></p><p id="bottle-cycle" class="game-status" role="status"></p><button id="bottle-reset-cycle" class="bottle-reset" type="button">{m.bottleResetCycle}</button><h2 class="game-history-heading">{m.bottleHistory}</h2><ol id="bottle-history" class="game-history"></ol><button id="bottle-new" class="bottle-new" type="button">{m.bottleStart}</button></div>
          <p id="bottle-error" class="game-error" role="alert" hidden></p>
        </section></section>
      </> : <>
        <section class="tool-strip" aria-label={m.gameNav}><img class="tool-icon" src={playIcon.src} width="20" height="20" alt="" aria-hidden="true" /><span class="tool-name">{m.gameNav}</span><span class="tool-caption">{m.gameDescription}</span><span class="tool-presence">{m.localOnly}</span></section>
        <section class="game-layout"><section class="game-panel" aria-labelledby="game-title">
          <div class="game-heading"><div><span class="section-kicker">LAVBE / {m.gameNav.toUpperCase()}</span><h1 id="game-title">{seo.approvedCopy?.h1 ?? m.gameTitle}</h1></div><span class="game-round" aria-hidden="true">✦</span></div>
          <p class="game-description">{m.gameDescription}</p><p class="game-status" id="game-pack-language">{m.gamePackLanguageNotice}</p>
          <form id="game-setup" class="game-setup"><label for="game-pack">{m.gamePackLabel}<select class="motion-select" id="game-pack"><option value="icebreakers">{m.gameFamilyIcebreakers}</option><option value="friends">{m.gameFamilyFriends}</option><option value="couples">{m.gameFamilyCouples}</option><option value="truth">{m.gameFamilyTruth}</option><option value="dare">{m.gameFamilyDare}</option><option value="family">{m.gameFamilyFamily}</option></select></label><label for="game-players">{m.gamePlayersLabel}<textarea id="game-players" rows="5" autocomplete="off" required>Aylin&#10;Murad&#10;Leyla</textarea></label><p class="game-safety">{m.gameDraftPackWarning}<br />{m.gamePassNotice}</p><button class="spin-button" id="game-start" type="submit" disabled><img class="spin-icon" src={playIcon.src} width="18" height="18" alt="" aria-hidden="true" />{m.gameStart}</button></form>
          <div id="game-play" class="game-play" hidden><label for="saved-games">{m.gameSavedGames}<select class="motion-select" id="saved-games"></select></label><p id="game-status" class="game-status" role="status"></p><article id="game-card" class="game-card" aria-live="polite" hidden><span id="game-player" class="game-player"></span><p id="game-card-text" class="game-card-text"></p><small id="game-card-count" class="game-card-count"></small></article><div class="game-actions"><button id="game-draw" class="spin-button" type="button">{m.gameDraw}</button><button id="game-done" type="button">{m.gameDone}</button><button id="game-skip" type="button">{m.gameSkip}</button><button id="game-pause" type="button">{m.gamePause}</button><button id="game-resume" type="button">{m.gameResume}</button><button id="game-restart" type="button">{m.gameRestart}</button><button id="game-end" type="button">{m.gameEnd}</button><button id="game-new" type="button">{m.gameStart}</button></div><h2 class="game-history-heading">{m.gameHistoryHeading}</h2><ol id="game-history" class="game-history"></ol></div>
          <p id="game-error" class="game-error" role="alert" hidden></p>
        </section></section>
      </>}
      <footer><span>Lavbe <span class="footer-sep">·</span>{m.footerTagline}</span><span>{m.footerPromise}</span></footer>
    </main>
    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle'), root = document.documentElement;
        const save = (key, value) => { try { localStorage.setItem(key, value); } catch { /* Preference stays temporary. */ } };
        const setTheme = (theme) => {
          const themes = JSON.parse(root.dataset.themeTokens || '{}');
          const variables = { canvas: '--canvas-token', surface: '--surface-token', text: '--text-token', mutedText: '--muted-token', primary: '--primary-token', onPrimary: '--on-primary', border: '--border-token', focus: '--focus-token' };
          root.dataset.theme = theme; for (const [key, variable] of Object.entries(variables)) root.style.setProperty(variable, themes[theme][key]);
          button?.setAttribute('aria-label', theme === 'dark' ? button.dataset.lightLabel : button.dataset.darkLabel);
          const icon = button?.querySelector('img'); if (icon && button) icon.src = theme === 'dark' ? button.dataset.lightIcon : button.dataset.darkIcon;
        };
        setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
        button?.addEventListener('click', () => { const next = root.dataset.theme === 'dark' ? 'light' : 'dark'; save('lavbe.theme', next); setTheme(next); });
      })();
    </script>
    <script src="../../scripts/pwa-client.ts"></script>
    <script src="../../scripts/consent.ts"></script>
    <script src="../../scripts/localized-tool.ts"></script>
  </body>
</html>
