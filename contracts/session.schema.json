{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lavbe.com/contracts/session.schema.json",
  "title": "Lavbe local session export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "wheelId",
    "engineVersion",
    "createdAt",
    "configRevisions",
    "rounds",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "wheelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "engineVersion": {
      "const": "selection-v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "configRevisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "entries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "mode": {
            "enum": [
              "independent",
              "remove-winner",
              "shuffled-cycle"
            ]
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "weight"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,64}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              }
            }
          }
        }
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "startedAt",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "enum": [
              "session-start",
              "manual-config-change",
              "mode-change"
            ]
          }
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roundId",
          "configRevisionId",
          "sequence",
          "committedAt",
          "selectedEntryId",
          "selectedLabel",
          "presentation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "roundId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "configRevisionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "committedAt": {
            "type": "string",
            "format": "date-time"
          },
          "selectedEntryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "selectedLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "presentation": {
            "enum": [
              "pending",
              "revealed",
              "acknowledged"
            ]
          },
          "cardId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "cardStatus": {
            "enum": [
              "pending",
              "completed",
              "skipped"
            ]
          }
        }
      }
    }
  }
}
