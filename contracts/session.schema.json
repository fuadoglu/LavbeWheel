                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "properties": {
                          "weight": {
                            "const": 1
                          },
                          "active": {
                            "const": true
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "not": {
                        "const": "numbers"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "range"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "not": {
                        "const": "teams"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "teamCount"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "not": {
                        "const": "bottle"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "seats"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "not": {
                        "const": "game"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "game"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "numbers"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "entries": {
                      "maxItems": 0
                    }
                  }
                },
                "else": {
