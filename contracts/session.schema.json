                  },
                  "packVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "numbers"
                    }
                  }
                },
                "then": {
                  "required": [
                    "range"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "teams"
                    }
                  }
                },
                "then": {
                  "required": [
                    "teamCount"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "bottle"
                    }
                  }
                },
                "then": {
                  "required": [
                    "seats"
                  ]
                }
              },
              {
                "if": {
