                        "validated",
                        "reviewed"
                      ]
                    },
                    "sourceHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "reviewedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "review": {
                        "properties": {
                          "status": {
                            "const": "reviewed"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "review": {
                        "required": [
                          "reviewer",
                          "reviewedAt"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
