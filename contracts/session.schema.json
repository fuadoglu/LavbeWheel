                },
                "minPlayers": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20
                },
                "maxPlayers": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20
                },
                "audience": {
                  "enum": [
                    "family",
                    "teen",
                    "adult"
                  ]
                },
                "intensity": {
                  "enum": [
                    "gentle",
                    "playful",
                    "bold"
                  ]
                },
                "cards": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "kind",
                      "text",
                      "equipment",
                      "estimatedSeconds"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{8,64}$"
                      },
                      "kind": {
                        "enum": [
                          "question",
                          "dare",
                          "activity"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "equipment": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
