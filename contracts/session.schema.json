                    "tool": {
                      "const": "game"
                    }
                  }
                },
                "then": {
                  "required": [
                    "game"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "weighted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "independent",
                        "remove-winner"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "teams"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "mode": {
                      "const": "independent"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "numbers"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "mode": {
                      "const": "independent"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tool": {
                      "const": "yes-no"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "mode": {
                      "const": "independent"
                    },
