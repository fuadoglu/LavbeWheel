{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "wheel"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "wheel": {
      "title": "Lavbe shared wheel configuration v1",
      "description": "Label and title maxLength are defensive code-point limits; enforce grapheme limits and semantic constraints separately. This is configuration, not session/report data.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "tool",
        "title",
        "locale",
        "mode",
        "entries",
        "settings"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "tool": {
          "enum": [
            "names",
            "numbers",
            "yes-no",
            "weighted",
            "teams",
            "bottle",
            "game"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "az",
            "tr",
            "ru",
            "es",
            "pt",
            "pt-BR",
            "de",
            "fr",
            "it",
            "nl",
            "pl",
            "uk",
            "ro",
            "hu",
            "cs",
            "sk",
            "bg",
            "sr",
            "hr",
            "bs",
            "sl",
            "mk",
            "sq",
            "en-GB",
            "el",
            "sv",
            "no",
            "da",
            "fi",
            "is",
            "et",
            "lv",
            "lt",
            "ar",
            "he",
            "fa",
            "ur",
            "ps",
            "ku",
            "ckb",
            "hi",
            "bn",
            "pa",
            "gu",
            "mr",
            "ne",
            "si",
            "ta",
            "te",
            "kn",
            "ml",
            "or",
            "as",
            "zh-Hans",
            "zh-Hant",
            "ja",
            "ko",
            "vi",
            "th",
            "id",
            "ms",
            "fil",
            "jv",
            "su",
            "km",
            "lo",
            "my",
            "mn",
            "kk",
            "ky",
            "uz",
            "tk",
            "tg",
            "ka",
            "hy",
            "sw",
            "am",
            "ha",
            "yo",
            "ig",
            "zu",
            "xh",
            "af",
            "so",
            "om",
            "rw",
            "mg",
            "sn",
            "st",
            "tn",
            "ny",
            "wo",
            "ff",
            "ht",
            "ca",
            "eu",
            "gl",
            "cy",
            "ga",
            "gd",
            "mt",
            "lb",
            "be",
            "la",
            "eo",
            "mi",
            "sm",
            "haw",
            "fy"
          ]
        },
        "mode": {
          "enum": [
            "independent",
            "remove-winner",
            "shuffled-cycle"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "weight",
              "active"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,64}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "active": {
                "type": "boolean"
              }
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "theme",
            "style",
            "motion",
            "sound",
            "spinSeconds"
          ],
          "properties": {
            "theme": {
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            "style": {
              "enum": [
                "classic",
                "bottle",
                "couples",
                "friends",
                "education"
              ]
            },
            "motion": {
              "enum": [
                "quiet",
                "standard",
                "party"
              ]
            },
            "sound": {
              "type": "boolean"
            },
            "spinSeconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        },
        "teamCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50
        },
        "seats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        },
        "game": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packId",
            "packVersion"
          ],
          "properties": {
            "packId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,64}$"
            },
            "packVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "numbers"
              }
            }
          },
          "then": {
            "required": [
              "range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "teams"
              }
            }
          },
          "then": {
            "required": [
              "teamCount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "bottle"
              }
            }
          },
          "then": {
            "required": [
              "seats"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "game"
              }
            }
          },
          "then": {
            "required": [
              "game"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "weighted"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "independent",
                  "remove-winner"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "teams"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "independent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "numbers"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "independent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "yes-no"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "independent"
              },
              "entries": {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "properties": {
                    "weight": {
                      "const": 1
                    },
                    "active": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "not": {
                  "const": "numbers"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "range"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "not": {
                  "const": "teams"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "teamCount"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "not": {
                  "const": "bottle"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "seats"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "not": {
                  "const": "game"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "game"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "numbers"
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "entries": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
