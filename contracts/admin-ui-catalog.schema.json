{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "message",
    "sourceHash",
    "status"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    }
  }
}
