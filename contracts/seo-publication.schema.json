{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lavbe.com/contracts/seo-publication.schema.json",
  "title": "Published localized route approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "routeId", "path", "sourceHash", "title", "description", "h1", "modules", "copyReviewer", "copyReviewedAt", "seoReviewer", "seoReviewedAt", "status"],
  "properties": {
    "locale": { "type": "string", "minLength": 2, "maxLength": 16 },
    "routeId": { "type": "string", "minLength": 1, "maxLength": 48 },
    "path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9-]+/)*$", "maxLength": 240 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "h1": { "type": "string", "minLength": 1, "maxLength": 200 },
    "modules": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["tool", "how-to", "rules", "examples", "privacy", "related-links", "accessible-alternative", "probability"] }
    },
    "copyReviewer": { "type": "string", "minLength": 2, "maxLength": 120 },
    "copyReviewedAt": { "type": "string", "format": "date-time" },
    "seoReviewer": { "type": "string", "minLength": 2, "maxLength": 120 },
    "seoReviewedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "published" }
  }
}
