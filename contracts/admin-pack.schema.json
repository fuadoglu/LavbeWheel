{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Localized game pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "family",
    "locale",
    "minPlayers",
    "maxPlayers",
    "audience",
    "intensity",
    "cards",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "family": {
      "enum": [
        "icebreakers",
        "friends",
        "couples",
        "truth",
        "dare",
        "family"
      ]
    },
    "locale": {
      "enum": [
        "en",
        "az",
        "tr",
        "ru",
        "es",
        "pt",
        "pt-BR",
        "de",
        "fr",
        "it",
        "nl",
        "pl",
        "uk",
        "ro",
        "hu",
        "cs",
        "sk",
        "bg",
        "sr",
        "hr",
        "bs",
        "sl",
        "mk",
        "sq",
        "en-GB",
        "el",
        "sv",
        "no",
        "da",
        "fi",
        "is",
        "et",
        "lv",
        "lt",
        "ar",
        "he",
        "fa",
        "ur",
        "ps",
        "ku",
        "ckb",
        "hi",
        "bn",
        "pa",
        "gu",
        "mr",
        "ne",
        "si",
        "ta",
        "te",
        "kn",
        "ml",
        "or",
        "as",
        "zh-Hans",
        "zh-Hant",
        "ja",
        "ko",
        "vi",
        "th",
        "id",
        "ms",
        "fil",
        "jv",
        "su",
        "km",
        "lo",
        "my",
        "mn",
        "kk",
        "ky",
        "uz",
        "tk",
        "tg",
        "ka",
        "hy",
        "sw",
        "am",
        "ha",
        "yo",
        "ig",
        "zu",
        "xh",
        "af",
        "so",
        "om",
        "rw",
        "mg",
        "sn",
        "st",
        "tn",
        "ny",
        "wo",
        "ff",
        "ht",
        "ca",
        "eu",
        "gl",
        "cy",
        "ga",
        "gd",
        "mt",
        "lb",
        "be",
        "la",
        "eo",
        "mi",
        "sm",
        "haw",
        "fy"
      ]
    },
    "minPlayers": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20
    },
    "maxPlayers": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20
    },
    "audience": {
      "enum": [
        "family",
        "teen",
        "adult"
      ]
    },
    "intensity": {
      "enum": [
        "gentle",
        "playful",
        "bold"
      ]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "text",
          "equipment",
          "estimatedSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "kind": {
            "enum": [
              "question",
              "dare",
              "activity"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "equipment": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "estimatedSeconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 600
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceHash"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "validated",
            "reviewed"
          ]
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "reviewer",
              "reviewedAt"
            ]
          }
        }
      }
    }
  ]
}
