          "shareId",
          "wheel",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "shareId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{32}$"
          },
          "wheel": {
            "$ref": "#/components/schemas/Wheel"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "parameters": {
      "ShareId": {
        "name": "shareId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
