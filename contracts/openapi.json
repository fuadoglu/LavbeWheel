          },
          "manageToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": false,
            "description": "Secret returned only on creation or authorized idempotent replay; never in URLs/logs."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SharedWheel": {
        "type": "object",
        "additionalProperties": false,
